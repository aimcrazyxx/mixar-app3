@@ -0,0 +1,35 @@
+# SPDX-FileCopyrightText: 2026 aimcrazyxx
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""Validate a user-selected cloud API base without contacting it."""
+from urllib.parse import urlsplit
+
+
+def normalize_base_url(value):
+    value = (value or "").strip().rstrip("/")
+    if not value:
+        return None
+    try:
+        url = urlsplit(value)
+        port = url.port
+    except ValueError:
+        raise ValueError("Enter a valid HTTPS API base URL.") from None
+    if (url.scheme != "https" or not url.hostname or url.username is not None
+            or url.password is not None or url.query or url.fragment
+            or any(c.isspace() for c in value) or any(ord(c) < 32 for c in value)):
+        raise ValueError("Use an HTTPS base URL without credentials, query or fragment.")
+    if url.path.endswith(("/chat/completions", "/responses", "/messages")):
+        raise ValueError("Enter the API base, for example https://api.example.com/v1.")
+    return value
+
+
+def endpoint_confirmed(data, base_url):
+    """Require the server's echo to confirm the selected endpoint."""
+    if not isinstance(data, dict):
+        return False
+    items = data.get("items") or []
+    return bool(items) and all(
+        isinstance(item, dict)
+        and (item.get("base_url") or "").rstrip("/") == base_url.rstrip("/")
+        for item in items
+    )
