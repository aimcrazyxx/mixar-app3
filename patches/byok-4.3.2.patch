diff --git a/tests/test_byok_custom_endpoint.py b/tests/test_byok_custom_endpoint.py
new file mode 100644
index 0000000..28f50e6
--- /dev/null
+++ b/tests/test_byok_custom_endpoint.py
@@ -0,0 +1,151 @@
+# SPDX-FileCopyrightText: 2026 aimcrazyxx
+# SPDX-License-Identifier: GPL-3.0-or-later
+import importlib.util
+from pathlib import Path
+import pytest
+
+FILE = Path(__file__).resolve().parents[1] / "src/scripts/mixar/modules/byok/core/custom_endpoint.py"
+spec = importlib.util.spec_from_file_location("custom_endpoint", FILE)
+endpoint = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(endpoint)
+
+
+def test_normalize_preserves_version_prefix():
+    assert endpoint.normalize_base_url(" https://api.example.com/proxy/v1/ ") == "https://api.example.com/proxy/v1"
+    assert endpoint.normalize_base_url("") is None
+
+
+@pytest.mark.parametrize("url", [
+    "http://api.example.com/v1", "https://user:pass@api.example.com/v1",
+    "https://api.example.com/v1?key=secret", "https://api.example.com/v1#x",
+    "https://api.example.com:bad/v1", "https://api.example.com/v1/chat/completions",
+    "https://api.example.com/v1/responses", "https://api.example.com/v1/messages",
+    "https://api.ex ample.com/v1",
+])
+def test_reject_invalid_api_bases(url):
+    with pytest.raises(ValueError):
+        endpoint.normalize_base_url(url)
+
+
+def test_does_not_accept_ignored_base_url():
+    assert not endpoint.endpoint_confirmed({"items": [{"provider": "openai"}]}, "https://api.example.com/v1")
+    assert not endpoint.endpoint_confirmed({"items": []}, "https://api.example.com/v1")
+    assert endpoint.endpoint_confirmed({"items": [{"base_url": "https://api.example.com/v1/"}]}, "https://api.example.com/v1")
+
+
+def test_custom_endpoint_persisted_with_device_key(monkeypatch):
+    from mixar.modules.byok.core import byok_client, key_store
+    saved = []
+    monkeypatch.setattr(key_store, "save", lambda record, user_id: saved.append((record, user_id)) or True)
+    assert byok_client._store_local_key("openai", "test-key", None, "custom-model", "test-user", "https://api.example.com/v1")
+    record, user_id = saved[0]
+    assert record["base_url"] == "https://api.example.com/v1"
+    assert record["key"] == "test-key"
+    assert record["model"] == "custom-model"
+    assert user_id == "test-user"
+
+
+class _InlineThread:
+    def __init__(self, target=None, **_kw):
+        self._target = target
+
+    def start(self):
+        self._target()
+
+
+def _save_with_unconfirmed_endpoint(monkeypatch, withdrawn):
+    """Save to a custom Base URL against a server that activates the key but
+    echoes no base_url (it ignored the field and used its standard host)."""
+    from types import SimpleNamespace
+    from mixar.modules.byok.core import byok_client, key_store
+
+    live = {"byok_active": True, "items": [{"provider": "openai", "model": "custom-model"}]}
+    monkeypatch.setattr(byok_client, "threading", SimpleNamespace(Thread=_InlineThread))
+    monkeypatch.setattr(byok_client, "_schedule_on_main", lambda fn, *a: fn(*a))
+    monkeypatch.setattr(byok_client, "_put_sealed", lambda *a, **k: (True, live, None))
+    monkeypatch.setattr(key_store, "current_user_id", lambda: "test-user")
+    stored, withdraw_calls = [], []
+    monkeypatch.setattr(byok_client, "_store_local_key", lambda *a, **k: stored.append(a) or True)
+
+    def _withdraw(data):
+        withdraw_calls.append(data)
+        return withdrawn if withdrawn is not None else data
+
+    monkeypatch.setattr(byok_client, "_withdraw_unconfirmed_endpoint", _withdraw)
+    done = []
+    byok_client.save_credentials("openai", "custom-model", "test-key", lambda *a: done.append(a),
+                                 base_url="https://api.example.com/v1")
+    return live, done, stored, withdraw_calls
+
+
+def test_unconfirmed_endpoint_is_withdrawn_and_never_stored(monkeypatch):
+    from mixar.modules.byok.core import byok_client
+
+    inactive = {"byok_active": False, "items": []}
+    live, done, stored, withdraw_calls = _save_with_unconfirmed_endpoint(monkeypatch, inactive)
+    assert withdraw_calls == [live]
+    assert stored == []  # this device never holds a key for an endpoint nobody confirmed
+    assert done == [(False, inactive, byok_client._ENDPOINT_UNCONFIRMED_MSG)]
+
+
+def test_withdraw_reports_nothing_active_only_once_the_delete_lands(monkeypatch):
+    from mixar.modules.byok.core import byok_client
+
+    live = {"byok_active": True, "items": [{"provider": "openai"}]}
+    calls = []
+
+    class _Service:
+        def delete_credentials_all(self):
+            calls.append("delete")
+            return "response"
+
+    monkeypatch.setattr(byok_client, "get_agent_service", lambda: _Service())
+    monkeypatch.setattr(byok_client, "_translate", lambda response: (True, {"removed": 1}, None))
+    assert byok_client._withdraw_unconfirmed_endpoint(live) == {"byok_active": False, "items": []}
+    assert calls == ["delete"]
+
+    monkeypatch.setattr(byok_client, "_translate", lambda response: (False, None, "nope"))
+    assert byok_client._withdraw_unconfirmed_endpoint(live) is live
+
+    class _Down:
+        def delete_credentials_all(self):
+            raise ConnectionError("offline")
+
+    monkeypatch.setattr(byok_client, "get_agent_service", lambda: _Down())
+    assert byok_client._withdraw_unconfirmed_endpoint(live) is live
+
+
+def test_form_reserves_room_for_the_custom_endpoint_fields():
+    """The fields only fit if FormPlan.need counts them: once per group drawn
+    by _custom_endpoint_fields, computed after self.kind is known."""
+    import ast
+
+    source = (Path(__file__).resolve().parents[1]
+              / "src/scripts/mixar/modules/byok/ui/operators/byok_provider_settings_ui.py").read_text()
+    plan = next(node for node in ast.walk(ast.parse(source))
+                if isinstance(node, ast.ClassDef) and node.name == "FormPlan")
+    methods = {node.name: node for node in plan.body if isinstance(node, ast.FunctionDef)}
+
+    init = ast.get_source_segment(source, methods["__init__"])
+    assert "groups = 2 if self.kind == 'cloud' else 1" in init
+    assert "self.need += groups * (S.GAP + S.NOTE_H + S.FIELD_H)" in init
+
+    for name, method in methods.items():
+        for block in ast.walk(method):
+            body = getattr(block, "body", None)
+            if not isinstance(body, list):
+                continue
+            returns = [i for i, stmt in enumerate(body) if isinstance(stmt, ast.Return)]
+            assert not returns or returns[0] == len(body) - 1, f"unreachable code after return in {name}"
+
+
+def test_form_target_takes_the_typed_model_only_with_a_custom_base_url():
+    from types import SimpleNamespace
+
+    picked = SimpleNamespace(byok_form_base_url="", byok_form_custom_model="ignored",
