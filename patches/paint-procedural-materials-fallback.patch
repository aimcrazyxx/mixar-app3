+# SPDX-FileCopyrightText: 2026 aimcrazyxx
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""Backend procedural material library status (public-source fallback).
+
+The library is downloaded by Mixar's private MatGen client, which the public
+source does not ship, so every request reports FAILED - the status callers
+already treat as "library unavailable" - and nothing is ever fetched.
+"""
+
+from ....config.logging_config import get_logger
+
+logger = get_logger(__name__)
+
+IDLE = "idle"
+LOADING = "loading"
+LOADED = "loaded"
+FAILED = "failed"
+SERVER_SOURCE = "server"
+
+_reported = False
+
+
+def _report_unavailable() -> None:
+    global _reported
+    if not _reported:
+        _reported = True
+        logger.info("Procedural material library unavailable: its backend client "
+                    "is not part of the public Mixar source")
+
+
+def catalog_status() -> str:
+    return FAILED
+
+
+def ensure_server_catalog() -> str:
+    _report_unavailable()
+    return FAILED
+
+
+def load_server_catalog() -> None:
+    _report_unavailable()
+
+
+def reset_server_catalog() -> None:
+    """Nothing is cached."""
+
+
+def is_server_material(material) -> bool:
+    return getattr(material, "source", "") == SERVER_SOURCE
+
+
+def is_script_available(material_id: str) -> bool:
+    return False
