+# SPDX-FileCopyrightText: 2026 aimcrazyxx
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""AI material generation (MatGen) queue (public-source fallback).
+
+MatGen's client is private to Mixar. Every caller already turns an exception
+from enqueue_matgen_job into a user-facing error (or an agent tool error), so
+raising is how this build says the feature is missing.
+"""
+
+MATGEN_UNAVAILABLE_MSG = (
+    "AI material generation (MatGen) is not available in builds made from the "
+    "public Mixar source."
+)
+
+
+class MatGenUnavailableError(RuntimeError):
+    pass
+
+
+def enqueue_matgen_job(prompt: str = "", pipeline: str = "fast", **_options):
+    raise MatGenUnavailableError(MATGEN_UNAVAILABLE_MSG)
