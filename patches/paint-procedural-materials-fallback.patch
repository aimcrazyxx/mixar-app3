+# SPDX-FileCopyrightText: 2026 aimcrazyxx
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""MatGen HTTP helpers (public-source fallback).
+
+There is no MatGen client here; this keeps the one contract the rest of the
+code relies on - direct backend requests carry the client version header -
+for anything that builds such a request.
+"""
+
+from ...common.api.client_version import client_version_headers
+
+
+def _auth_headers(token: str) -> dict:
+    return {"Authorization": f"Bearer {token}", **client_version_headers()}
