--- /dev/null
+++ b/src/scripts/mixar/modules/paint/procedural_materials/material_registry.py
@@ -0,0 +1,136 @@
+# SPDX-FileCopyrightText: 2026 aimcrazyxx
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""Procedural materials known to this session (public-source fallback).
+
+The surface the paint module uses from the private registry. Materials come
+only from callers - the layered build registers its detail layers - and their
+scripts are never run (see the package docstring), so a node group resolves
+only when the material names one that already exists in the file.
+"""
+
+from dataclasses import dataclass
+from typing import Dict, List, Optional
+
+import bpy
+
+from ....config.logging_config import get_logger
+from . import server_catalog
+
+logger = get_logger(__name__)
+
+# The layer type every procedural material layer carries (its material id
+# lives in layer.procedural_material_id).
+PROCEDURAL_LAYER_TYPE = "PROCEDURAL"
+LOCAL_SOURCE = "local"
+
+
+@dataclass
+class ProceduralMaterial:
+    material_id: str
+    name: str
+    category: str = "uncategorized"
+    script: str = ""
+    script_path: str = ""
+    # Explicit only: guessing from the display name could bind an unrelated
+    # node group of the user's file as the layer source.
+    node_group_name: str = ""
+    source: str = LOCAL_SOURCE
+
+
+class MaterialRegistry:
+    def __init__(self):
+        self._materials: Dict[str, ProceduralMaterial] = {}
+        self._warned_unbuilt = set()
+
+    def register_material(self, material: ProceduralMaterial) -> None:
+        self._materials[material.material_id] = material
+
+    def unregister_material(self, material_id: str) -> None:
+        self._materials.pop(material_id, None)
+
+    def get_material(self, material_id: str) -> Optional[ProceduralMaterial]:
+        return self._materials.get(material_id) if material_id else None
+
+    def get_all_materials(self) -> List[ProceduralMaterial]:
+        return list(self._materials.values())
+
+    def get_categories(self) -> List[str]:
+        return sorted({material.category for material in self._materials.values()})
+
+    def get_materials_by_category(self, category: str) -> List[ProceduralMaterial]:
+        return [material for material in self._materials.values() if material.category == category]
+
+    def get_node_group(self, material_id: str):
+        material = self.get_material(material_id)
+        if material is None:
+            return None
+        node_group = (bpy.data.node_groups.get(material.node_group_name)
+                      if material.node_group_name else None)
+        if node_group is None and material_id not in self._warned_unbuilt:
+            self._warned_unbuilt.add(material_id)
+            logger.warning(
+                "Procedural material %r has no node group: material scripts only run "
+                "in Mixar's official builds", material_id,
+            )
+        return node_group
+
+    def clear(self) -> None:
+        self._materials.clear()
+        self._warned_unbuilt.clear()
+
+
+_registry = MaterialRegistry()
+
+
+def get_registry() -> MaterialRegistry:
+    return _registry
+
+
+def register_material(material: ProceduralMaterial) -> None:
+    _registry.register_material(material)
+
+
+def get_material(material_id: str) -> Optional[ProceduralMaterial]:
+    return _registry.get_material(material_id)
+
+
+def get_all_materials() -> List[ProceduralMaterial]:
+    return _registry.get_all_materials()
+
+
+def get_categories() -> List[str]:
+    return _registry.get_categories()
+
+
+def get_materials_by_category(category: str) -> List[ProceduralMaterial]:
+    return _registry.get_materials_by_category(category)
+
+
+def get_node_group(material_id: str):
+    return _registry.get_node_group(material_id)
+
+
+def get_node_group_blocking(material_id: str):
+    """Same as get_node_group: there is no script download to wait for."""
+    return _registry.get_node_group(material_id)
+
+
+def is_custom_material(layer_type: str) -> bool:
+    """True for a procedural layer: its layer type, or a registered material id."""
+    if not layer_type:
+        return False
+    return layer_type == PROCEDURAL_LAYER_TYPE or _registry.get_material(layer_type) is not None
+
+
+def load_server_catalog() -> None:
+    server_catalog.load_server_catalog()
+
+
+def load_matgen_materials() -> None:
+    """The user's generated materials come from MatGen, which this build lacks."""
+
+
+def unload_all_materials() -> None:
+    _registry.clear()
+    server_catalog.reset_server_catalog()
