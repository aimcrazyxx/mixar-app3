@@ -0,0 +1,115 @@
+# SPDX-FileCopyrightText: 2026 aimcrazyxx
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""The public-source stand-in for the private paint/procedural_materials
+package: the paint module imports again, standard layer types stay standard,
+procedural layers fail closed, and no material script ever runs."""
+
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+SCRIPTS = ROOT / "src" / "scripts"
+if str(SCRIPTS) not in sys.path:
+    sys.path.insert(0, str(SCRIPTS))
+
+from mixar.modules.testing.mock_bpy import install_bpy_mock  # noqa: E402
+
+install_bpy_mock()
+
+from mixar.modules.paint import procedural_materials  # noqa: E402
+from mixar.modules.paint.procedural_materials import (  # noqa: E402
+    material_registry as MR,
+    matgen_queue,
+    server_catalog as SC,
+)
+
+
+@pytest.fixture(autouse=True)
+def _empty_registry():
+    MR.unload_all_materials()
+    yield
+    MR.unload_all_materials()
+
+
+def test_is_the_public_source_fallback():
+    assert procedural_materials.PUBLIC_SOURCE_FALLBACK is True
+
+
+@pytest.mark.parametrize("module", [
+    "mixar.modules.paint.core.element.modifier_utils",
+    "mixar.modules.paint.core.io.utils.source_connections",
+    "mixar.modules.paint.core.io.utils.depth_connections",
+    "mixar.modules.paint.layered_build.procedural_layer",
+    "mixar.modules.paint.core.agent_tools.material_library",
+    "mixar.modules.auth.core.auth_hooks",
+])
+def test_modules_importing_the_package_load(module):
+    __import__(module)
+
+
+def test_standard_layer_types_are_not_custom():
+    for layer_type in ("IMAGE", "COLOR", "NOISE", "VCOL", "GROUP", "", None):
+        assert MR.is_custom_material(layer_type) is False
+
+
+def test_procedural_layers_and_registered_ids_are_custom():
+    assert MR.is_custom_material("PROCEDURAL") is True
+    MR.get_registry().register_material(MR.ProceduralMaterial(
+        material_id="rust_01", name="Rust", category="metal"))
+    assert MR.is_custom_material("rust_01") is True
+    assert MR.get_material("rust_01").name == "Rust"
+    assert MR.get_categories() == ["metal"]
+    assert [m.material_id for m in MR.get_materials_by_category("metal")] == ["rust_01"]
+
+
+def test_a_material_script_is_never_executed(monkeypatch):
+    lookups = []
+    monkeypatch.setattr(MR.bpy.data, "node_groups",
+                        SimpleNamespace(get=lambda name: lookups.append(name)), raising=False)
+    MR.register_material(MR.ProceduralMaterial(
+        material_id="detail", name="Detail", category="layered_material",
+        script="raise SystemExit('a material script ran')"))
+    assert MR.get_node_group("detail") is None
+    assert MR.get_node_group_blocking("detail") is None
+    assert MR.get_node_group("unknown") is None
+    assert lookups == []  # no implicit by-name lookup either
+
+
+def test_an_explicit_node_group_already_in_the_file_resolves(monkeypatch):
+    group = object()
+    monkeypatch.setattr(MR.bpy.data, "node_groups",
+                        SimpleNamespace(get={"MP Rust": group}.get), raising=False)
+    MR.register_material(MR.ProceduralMaterial(
+        material_id="rust_01", name="Rust", node_group_name="MP Rust"))
+    assert MR.get_node_group("rust_01") is group
+
+
+def test_backend_library_reports_unavailable():
+    assert SC.ensure_server_catalog() == SC.FAILED
+    assert SC.catalog_status() == SC.FAILED
+    assert SC.is_script_available("rust_01") is False
+    assert SC.is_server_material(SimpleNamespace(source=SC.SERVER_SOURCE)) is True
+    assert SC.is_server_material(MR.ProceduralMaterial(material_id="m", name="M")) is False
+
+
+def test_agent_listing_keeps_local_materials_and_the_failed_status(monkeypatch):
+    from mixar.modules.paint.core.agent_tools import material_library as ML
+
+    monkeypatch.setattr(ML.bpy.data, "node_groups", SimpleNamespace(get=lambda name: None), raising=False)
+    MR.register_material(MR.ProceduralMaterial(
+        material_id="detail", name="Detail", category="layered_material", script="# s"))
+    result = ML.list_procedural_materials()
+    assert result["success"] is True
+    assert result["catalog_status"] == SC.FAILED
+    assert [m["material_id"] for m in result["materials"]] == ["detail"]
+    assert result["materials"][0]["source"] == "local"
+
+
+def test_matgen_fails_with_a_clear_error():
+    with pytest.raises(matgen_queue.MatGenUnavailableError, match="public Mixar source"):
+        matgen_queue.enqueue_matgen_job(prompt="rusty metal", pipeline="fast",
+                                        apply_to_object_names=["Cube"])
